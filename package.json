{
  "name": "api-poller-worker",
  "version": "2.0.0",
  "description": "Efficient polling with web workers. Make existing APIs feel real time",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmcallister/api-poller-worker.git"
  },
  "homepage": "https://brianmcallister.github.io/api-poller-worker/",
  "bugs": "https://github.com/brianmcallister/api-poller-worker/issues",
  "license": "MIT",
  "author": {
    "name": "Brian Wm. McAllister",
    "email": "brian@brianmcallister.com",
    "url": "https://www.brianmcallister.com"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "api",
    "polling",
    "real-time",
    "webworker",
    "web-worker",
    "javascript",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "lint:package": "publint",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
